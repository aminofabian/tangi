<!DOCTYPE html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <%!-- viewport-fit=cover lets the shell pad against the notch and home
          indicator via env(safe-area-inset-*). Maximum-scale is left alone so
          pinch-zoom stays available (accessibility). --%>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <meta name="theme-color" content="#03A2FC" />
    <meta name="color-scheme" content="light" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Tangi" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <%!-- Search Console ownership. Same string for every URL, so it lives here
          rather than on a page. --%>
    <meta
      name="google-site-verification"
      content="WDnKb4dvZxdQyOUiSsfB94HWTdVcOmwDfnsCV7iY8bU"
    />

    <%!-- Search. The root layout is rendered once, on the server, for every URL
          and a live navigation never touches it, so the title, description,
          canonical URL, social cards and structured data are all in the initial
          HTML a crawler receives without running JavaScript. A page assigns
          `:meta_title`, `:page_description`, `:canonical_url`, `:page_robots`
          and `:structured_data`; the fallbacks here keep every other page valid. --%>
    <meta
      name="description"
      content={assigns[:page_description] || ViewNinjasWeb.SEO.default_description()}
    />
    <meta name="robots" content={assigns[:page_robots] || "index, follow"} />
    <link :if={assigns[:canonical_url]} rel="canonical" href={assigns[:canonical_url]} />

    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:site_name" content="Tangi" />
    <meta property="og:locale" content="en_KE" />
    <meta
      property="og:title"
      content={assigns[:meta_title] || assigns[:page_title] || ViewNinjasWeb.SEO.default_title()}
    />
    <meta
      property="og:description"
      content={assigns[:page_description] || ViewNinjasWeb.SEO.default_description()}
    />
    <meta :if={assigns[:canonical_url]} property="og:url" content={assigns[:canonical_url]} />
    <meta property="og:image" content={assigns[:og_image] || ViewNinjasWeb.SEO.social_image()} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={ViewNinjasWeb.SEO.social_image_width()} />
    <meta property="og:image:height" content={ViewNinjasWeb.SEO.social_image_height()} />
    <meta property="og:image:alt" content="Tangi — social media growth in Kenya" />

    <%!-- `summary_large_image` so X/Twitter shows the 1200×630 card in full. --%>
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={assigns[:meta_title] || assigns[:page_title] || ViewNinjasWeb.SEO.default_title()}
    />
    <meta
      name="twitter:description"
      content={assigns[:page_description] || ViewNinjasWeb.SEO.default_description()}
    />
    <meta name="twitter:image" content={assigns[:og_image] || ViewNinjasWeb.SEO.social_image()} />
    <meta name="twitter:image:alt" content="Tangi — social media growth in Kenya" />

    <%!-- HEEx does not interpolate `{...}` inside a `<script>` tag, so these use
          the `<%= %>` form. `SEO.encode!/1` escapes `<`, `>` and `&`, so a
          title can never close the block early. --%>
    <script type="application/ld+json">
      <%= raw(ViewNinjasWeb.SEO.encode!(ViewNinjasWeb.SEO.organization())) %>
    </script>
    <script type="application/ld+json">
      <%= raw(ViewNinjasWeb.SEO.encode!(ViewNinjasWeb.SEO.website())) %>
    </script>
    <script :for={data <- assigns[:structured_data] || []} type="application/ld+json">
      <%= raw(ViewNinjasWeb.SEO.encode!(data)) %>
    </script>

    <link rel="manifest" href={~p"/manifest.json"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <%!-- The mascot on its own, for the tab icon; the .ico is the raster
          fallback. --%>
    <link rel="icon" href={~p"/images/logo-mark.png"} type="image/png" />
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />

    <%!-- Fredoka and Nunito, self-hosted and non-blocking (scope.md §12: never
          block first paint on a web font on a 3G phone). --%>
    <link
      rel="preload"
      href={~p"/fonts/fredoka-latin.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/nunito-latin.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <.live_title
      default="Tangi"
      suffix=" · Tangi"
      phx-no-format
    >{assigns[:meta_title] || assigns[:page_title]}</.live_title>

    <%!-- default.css first so the hand-written shell in app.css can override it. --%>
    <link phx-track-static rel="stylesheet" href={~p"/assets/default.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
